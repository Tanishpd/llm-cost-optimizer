# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment — never commit real keys
.env
.env.local
!.env.example

# Eval artifacts: cached API responses may contain prompt/response text,
# and re-running costs money. Keep the fitted calibrator, drop the raw runs.
# (Must be `/*`, not the bare directory: git never descends into an excluded
# directory, which would make the .gitkeep negation inert.)
# Run caches. The auto-graded ones regenerate for free, so they stay out.
eval/runs/*
!eval/runs/full.json
# ...but `full.json` is the paid evidence behind a documented result: real API
# responses that cost quota, backing RESEARCH.md 3.5. It is 119 KB, contains no
# credentials, and cannot be recreated without spending again. The docs say
# "never re-spend to recompute something already on disk" — that only holds if
# the disk is version-controlled.
!eval/runs/.gitkeep

# Local state
*.log
logs/
dump.rdb
*.rdb

# macOS
.DS_Store

# Audit trail (AUDIT_PATH). Durable by design, and not source.
audit/

# Coverage artifacts
.coverage
htmlcov/

# mutmut copies the tree here to mutate it.
mutants/

# hypothesis keeps a database of falsifying examples so a fixed bug stays
# fixed. Local only -- CI regenerates it.
.hypothesis/
