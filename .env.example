# Copy to .env and adjust. Defaults here match app/config.py and docs/PLAN.md.
# .env is gitignored — never commit a real key.

# ---- Local models (Ollama) -------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
SMALL_MODEL=qwen2.5:0.5b
LARGE_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=10m
# Do NOT raise on 8 GB RAM. Three resident models plus a browser will swap.
# See docs/DECISIONS.md D2.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_TIMEOUT_S=120
OLLAMA_CONNECT_TIMEOUT_S=5

# ---- Frontier tier ---------------------------------------------------------
# Points at the local mock by default. Swapping to a real provider is a change
# to these three lines and nothing else (docs/DECISIONS.md D9).
#   FRONTIER_BASE_URL=https://api.openai.com/v1
FRONTIER_BASE_URL=http://localhost:8001/v1
FRONTIER_API_KEY=mock-key
FRONTIER_MODEL=gpt-4o-mock
FRONTIER_TIMEOUT_S=60

# USD per 1M tokens. PLACEHOLDERS — verify current rates before quoting any
# savings figure publicly.
FRONTIER_PRICE_IN=2.50
FRONTIER_PRICE_OUT=10.00

# ---- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_LOCAL=3600
# Longer: frontier answers cost real money and are worth keeping.
CACHE_TTL_FRONTIER=86400

# ---- Semantic cache --------------------------------------------------------
SEMANTIC_ENABLED=true
# Conservative on purpose. A wrong hit is worse than a miss (DECISIONS.md D15).
SEMANTIC_THRESHOLD=0.95
SEMANTIC_MAX_CHARS=500
SEMANTIC_MAX_ENTRIES=10000

# ---- Streaming --------------------------------------------------------------
# stream=true buffers the whole cascade, then re-emits the finished answer as
# SSE. It does NOT lower time-to-first-token -- the gate needs the complete
# answer before it can decide. See docs/DECISIONS.md D8.
# Characters per content frame. 0 sends the answer in a single frame.
STREAM_CHUNK_CHARS=24

# ---- Tenancy and budgets ----------------------------------------------------
# A key is a credential; a tenant is an account. Without TENANTS every key
# draws on the same frontier spend.
#
# JSON on purpose: API keys are opaque and may contain ':' or '=', so any
# inline separator risks silently mis-splitting key material.
# TENANTS={"acme": {"keys": ["sk-a","sk-b"], "daily_budget_usd": "5.00", "rate_limit_per_minute": 30}}
# `rate_limit_per_minute` is optional; 0 or absent inherits RATE_LIMIT_PER_MINUTE.
# It only takes effect on the window it applies to, so pair it with
# RATE_LIMIT_SCOPE=tenant unless you mean "per key, for this tenant".
#
# Budgets are UTC-daily. Over budget DEGRADES (local tiers only), it does not
# reject -- the exception is a caller who pinned gateway:frontier, who gets a
# 402 because they removed the fallback themselves.
#
# Checked before the call, recorded after, because cost is not knowable until
# the provider replies. So a tenant can exceed their cap by at most one
# request: MAX_OUTPUT_TOKENS x FRONTIER_PRICE_OUT, ~$0.04 at the defaults.
#
# Applies to the implicit `default` and `anonymous` tenants. 0 = unlimited.
DEFAULT_DAILY_BUDGET_USD=0

# The gateway's OWN daily ceiling, across every tenant. Unlike the per-tenant
# budgets above this ships ARMED, because it is a safety limit rather than a
# business policy -- and a safety limit that defaults to off is how you learn
# about it from an invoice.
#
# It exists because invariant 4 ("Ollama down -> escalate everything") keeps the
# gateway answering at roughly $138/day per client at the shipped rate limit.
# When it binds, requests degrade to local tiers; if the local tiers are also
# down (the usual reason it binds) they get a loud 503 instead of a quiet bill.
# Raise it deliberately for real traffic. 0 disables it.
MAX_DAILY_SPEND_USD=10.00

# Whether cached answers may cross tenant boundaries.
#   global  (default) one cache for everyone -- where the cross-tenant savings
#           come from. A semantic hit can match another tenant's prompt, so the
#           reason string withholds the matched text in this mode.
#   tenant  the tenant is part of the cache key and filters the semantic index.
#           Costs the cross-tenant savings, buys isolation.
# See docs/DECISIONS.md D28.
CACHE_SCOPE=global

# ---- Shadow sampling --------------------------------------------------------
# Re-run this fraction of gate-ACCEPTED local answers against the frontier, out
# of band, to measure how often the cheap tier was wrong.
#
# OFF by default because it spends real money -- a shadow call is a real
# frontier call for an answer nobody reads. 0.01 costs roughly 1% of routing
# everything to the frontier, and buys a continuously updated false-cheap rate.
#
# Needs a REAL frontier: the mock's content is canned, so every comparison
# diverges and the rate reads 100%. Startup warns if you do this.
SHADOW_SAMPLE_RATE=0.0
# Below this token overlap the two answers count as divergent. A tripwire, not
# a grade -- watch the trend, not the value. See docs/DECISIONS.md D29.
SHADOW_DIVERGENCE_THRESHOLD=0.35

# ---- Audit trail ------------------------------------------------------------
# Durable, append-only JSONL: one line per request, including refusals.
# Telemetry is a capped Redis stream and answers "what is happening now"; this
# answers "why did request abc123 cost $0.04 last Tuesday".
AUDIT_ENABLED=true
AUDIT_PATH=audit
AUDIT_MAX_BYTES=52428800
AUDIT_KEEP_FILES=5
# Writes are queued and drained by a background task, so the request path never
# waits on a disk. A full queue DROPS rather than blocking, and the drops are
# counted in /healthz -- a trail with unreported holes is worse than none.
AUDIT_QUEUE_SIZE=10000
# Per-record fsync survives a machine crash, at a disk round-trip per request.
# Off by default: a flush per batch survives a process crash, which is the
# failure people actually have.
AUDIT_FSYNC=false

# ---- Confidence gating -----------------------------------------------------
# raw        -> THRESHOLD_* apply to geo_mean directly
# calibrated -> TARGET_*    apply to a fitted probability
# These are NOT the same scale. See docs/RESEARCH.md section 3.
#
# `calibrated` is the default since 0.4.0: both gates passed validation against
# a real frontier at n=110, so 0.85 means what it says (RESEARCH.md 3.7).
#
# It only works because eval/calibrator.json is committed AND was fitted on
# qwen2.5:0.5b / qwen2.5:3b -- the models this file also defaults to. Change
# SMALL_MODEL or LARGE_MODEL and the gateway REFUSES TO START, naming both
# model sets, because a calibrator fitted elsewhere still returns a number in
# [0, 1] that looks exactly like a probability. Run other models with raw.
CONFIDENCE_MODE=calibrated

# Where the fitted per-gate calibrators live, read once at startup. Missing is
# fine in raw mode; missing in calibrated mode REFUSES TO START, rather than
# quietly falling back to raw thresholds under a "calibrated" label.
CALIBRATOR_PATH=eval/calibrator.json

# Raw mode. NOTE: these two are per-model and NOT comparable to each other --
# the 0.5B's geo_mean distribution sits lower than the 3B's, so 0.55 < 0.62
# reflects the models, not a policy. Replaced by measurement in M6.
THRESHOLD_SMALL=0.55
THRESHOLD_LARGE=0.62

# Calibrated mode. Gate 1's bar is HIGHER on purpose: escalating from it costs
# ~450ms and no money, so escalate readily. Gate 2 spends real money, so it
# accepts more willingly -- and carries the spec's 0.85.
TARGET_SMALL=0.92
TARGET_LARGE=0.85

CONFIDENCE_STRATEGY=logprobs
TOP_LOGPROBS=5

# ---- Pre-router ------------------------------------------------------------
ROUTER_SMALL_MAX_TOKENS=60
ROUTER_ESCALATE_MIN_TOKENS=600

# ---- Gateway defaults ------------------------------------------------------
DEFAULT_MAX_TOKENS=512
DEFAULT_TEMPERATURE=0.0
# Warm both chat models with a 1-token call at startup, so the first real
# request doesn't pay the ~1.9s cold-load measured in M0.
WARM_MODELS_ON_STARTUP=true

# ---- Eval (M6 only) --------------------------------------------------------
# true spends REAL money: 1 reference completion + 1 judge call per local tier
# = 3 calls/prompt, ~360 across the set. Compute the cost from your actual
# rates first -- the prices above are placeholders. Responses cache to
# eval/runs/ -- always reuse that cache when re-fitting calibrators.
# Never enable for serving.
EVAL_USE_REAL_FRONTIER=false

# The judge is a SEPARATE provider from the frontier tier, so no model grades
# its own output. Reference answers come from FRONTIER_*; scoring from these.
EVAL_JUDGE_BASE_URL=https://api.anthropic.com/v1
EVAL_JUDGE_MODEL=claude-sonnet-5

# A one-word verdict still needs headroom: a REASONING model spends hidden
# thinking tokens against this budget and they do not appear in
# completion_tokens. At 10 (the old hardcoded value) gemini-3-flash-preview
# returned an empty string and every verdict parsed as None -- 129 paid calls,
# zero labels, no error anywhere. Measured: 10 fails, 64 works.
EVAL_JUDGE_MAX_TOKENS=64

# The reference answer's budget, SEPARATE from the local tiers'. One knob used
# to drive both, which truncated references to fragments like "The
# mitochondrion is an" -- the judge then compared a full local answer against
# four words. Local tiers must keep production's answer length; only the
# reference needs the headroom.
EVAL_REFERENCE_MAX_TOKENS=1024

# Seconds between eval API calls. 0 = as fast as the provider allows, right for
# a paid tier. Free tiers are tight -- Gemini's is 20 requests/minute -- and
# staying under a limit is faster than retrying through one.
EVAL_MIN_CALL_INTERVAL_S=0.0
# EVAL_JUDGE_API_KEY=

# What the JUDGE costs, per million tokens. Separate from FRONTIER_PRICE_*
# because the judge is deliberately a different model from the one it grades
# (D11), so it bills at different rates -- pricing 86 judge calls at the
# reference model's rate is just a wrong number.
#
# PLACEHOLDERS, like FRONTIER_PRICE_*. Verify against the provider's current
# rates before believing any total the eval prints.
#
# Verified 2026-07-29 at ai.google.dev/gemini-api/docs/pricing, paid tier, per
# 1M tokens -- a reference point, not a promise these are still current:
#
#   gemini-3-flash-preview   0.50 in / 3.00 out
#   gemini-2.5-flash         0.30 in / 2.50 out
#
# Google labels the output column "including thinking tokens", which is why
# `billable_out` charges the total_tokens gap rather than completion_tokens.
# On the M23 calibration run thinking was 36% ABOVE visible output, so the
# difference between the two readings was most of the bill.
EVAL_JUDGE_PRICE_IN=2.50
EVAL_JUDGE_PRICE_OUT=10.00

# OpenAI's `reasoning_effort`, sent only when non-empty. LEAVE EMPTY BY DEFAULT:
# the field is standard but its accepted VALUES are not --
#   gemini-2.5-flash   "none" disables thinking outright
#   gemini-3-*         no off switch at all; the floor is "low"
#   Anthropic          does not use this field (and is the default judge here)
# A non-empty default would 400 against this project's own documented judge.
#
# Worth setting to "none" for a Gemini 2.5 judge: it emits one word against a
# rubric, so thinking buys little, and hidden thinking is what broke the run at
# EVAL_JUDGE_MAX_TOKENS=10 -- it ate the whole budget and every verdict came
# back empty. Turned off, that failure cannot recur, and the cost stops being a
# range.
EVAL_JUDGE_REASONING_EFFORT=

# The REFERENCE is the gold standard every label is graded against. Turning its
# thinking down to save pennies degrades the thing you are paying to measure.
# Gemini 3 cannot disable it anyway.
EVAL_REFERENCE_REASONING_EFFORT=

# ---- Mock frontier service (mock_frontier/main.py) -------------------------
MOCK_LATENCY_MS=1800
MOCK_JITTER_MS=400
# Raise to exercise the degradation paths in M8.
MOCK_FAILURE_RATE=0.0

# ---- Security --------------------------------------------------------------
# Comma-separated API keys. EMPTY MEANS THE GATEWAY RUNS OPEN — anyone who can
# reach the port can spend your frontier budget. Only acceptable on a loopback
# bind; set REQUIRE_AUTH=true to make an open start a hard failure.
GATEWAY_API_KEYS=
REQUIRE_AUTH=false

# Sliding window per key (per client IP when open). 0 disables.
# In-process: under multiple workers the effective limit multiplies.
RATE_LIMIT_PER_MINUTE=60

# What one rate-limit window belongs to:
#   key    -- one window per API key (default, and the prior behaviour)
#   tenant -- one window per account, shared by all of that tenant's keys
#
# `key` is NOT tenant isolation: a tenant with ten keys gets ten windows and can
# consume ten times the limit, starving everyone else. Per-tenant BUDGETS do not
# close that gap -- they cap spend, and a cache-served request spends nothing
# while still consuming capacity.
#
# Unauthenticated requests stay keyed by IP under either setting: every
# anonymous caller resolves to the same `anonymous` tenant, so scoping them by
# tenant would put the whole internet in one bucket.
RATE_LIMIT_SCOPE=key

# Request bounds. Each is a cost control and a stability control at once —
# an unbounded max_tokens is an unbounded bill AND a request that occupies
# the only local model for minutes.
MAX_PROMPT_CHARS=32000
MAX_MESSAGES=50
MAX_OUTPUT_TOKENS=4096
MAX_BODY_BYTES=256000

# ---- Resilience ------------------------------------------------------------
# A dead tier otherwise costs every request a full timeout before the cascade
# escalates past it. The breaker turns that into a fast skip, then admits one
# probe after the cooldown to test recovery.
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_S=30

# Narrow by design: only timeouts and connection errors are retried, and the
# frontier is NOT retried on timeout because the tokens may already be billed.
RETRY_ATTEMPTS=2
RETRY_BASE_DELAY_S=0.25

# ---- Logging ---------------------------------------------------------------
# json emits one object per line with the trace id attached, so "which requests
# escalated twice" is a filter rather than a grep. text stays readable locally.
LOG_LEVEL=INFO
LOG_FORMAT=text
